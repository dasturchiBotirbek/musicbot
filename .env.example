# Bot tokeningizni @BotFather dan oling va shu yerga yozing
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Admin Telegram user ID (bir nechta bo'lsa, vergul bilan ajrating, masalan: 123456789,987654321)
ADMIN_IDS=123456789

# SQLite DB fayli (o'zgartirmasangiz ham bo'ladi)
DB_PATH=bot.db

# Yuklangan fayllar saqlanadigan vaqtinchalik papka
DOWNLOAD_DIR=downloads

# Maksimal fayl hajmi (MB) — Telegram Bot API cheklovi 50MB
MAX_FILE_SIZE_MB=50
